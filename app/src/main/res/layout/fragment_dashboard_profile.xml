<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- ===== GRADIENT HEADER ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="64dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnProfileMoreOptions"
            android:layout_alignParentTop="true">

            <TextView
                android:id="@+id/usernameonprofiletab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akun Saya"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/userEmailSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelola informasi data dan profil Anda"
                android:textSize="12sp"
                android:textColor="#C0D8FF"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Three Dots Menu Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnProfileMoreOptions"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#20FFFFFF"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <!-- ===== PROFILE AVATAR CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Avatar Circle -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/avatarCard"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        app:cardCornerRadius="34dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/cloud_mist"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/profileImageView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_default_whatsapp_profile" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:src="@drawable/ic_edit_pencil"
                                android:background="@drawable/badge_green_bg"
                                android:padding="3dp"
                                app:tint="@color/white" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Name & role -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/avatarCard"
                        android:layout_toStartOf="@id/btnEditProfile"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/editablename"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="17sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/contactedit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Edit Icon -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/cloud_mist"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit_pencil"
                            app:tint="@color/colorPrimary" />
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== INFO CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Akun"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Username Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/cloud_mist">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_baseline_account_circle_24"
                                app:tint="@color/colorPrimary" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Username"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                            <TextView
                                android:id="@+id/usernameedit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins_semibold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== MENU CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Update Password -->
                    <LinearLayout
                        android:id="@+id/btnEditInfoText"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_baseline_vpn_key_24"
                            app:tint="@color/colorPrimary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ganti Password"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_baseline_arrow_drop_down_24"
                            app:tint="@color/text_hint" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== LOGOUT BUTTON ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutonprofile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="Keluar dari Akun"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/error_red"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1.5dp"
                app:cornerRadius="28dp"
                android:textAllCaps="false" />

            <!-- Hidden compat fields -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView android:id="@+id/busrouteedit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/userAddressEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/userEmailEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/yearedit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/branchedit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
