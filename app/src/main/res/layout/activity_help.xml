<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".HelpActivity">

    <!-- Header Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarHelp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cosmic_ink"
        app:title="Bantuan &amp; Layanan"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_baseline_reply_24"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Cara Pemesanan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌 Cara Memesan Tiket"
                        android:textColor="@color/cosmic_ink"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_semibold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1. Pilih stasiun keberangkatan dan tujuan Anda di halaman utama.\n2. Pilih jadwal keberangkatan bus yang sesuai.\n3. Pilih nomor kursi bus yang diinginkan.\n4. Konfirmasi data pemesanan dan simpan tiket Anda."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="@font/poppins"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Pembatalan & Refund -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 Pembatalan &amp; Pengembalian Dana"
                        android:textColor="@color/cosmic_ink"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_semibold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tiket yang telah dikonfirmasi dapat dibatalkan maksimal 3 jam sebelum waktu keberangkatan yang tertera pada tiket. Hubungi CS melalui kontak di bawah untuk informasi lebih lanjut."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="@font/poppins"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Kontak CS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 Kontak Bantuan &amp; Customer Service"
                        android:textColor="@color/cosmic_ink"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_semibold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Email: support@ridesharebus.com\nTelepon / WhatsApp: +62 812-3456-7890\nJam Operasional: 24/7 Setiap Hari"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="@font/poppins"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
