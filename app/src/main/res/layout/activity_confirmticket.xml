<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context="orbit.ac.id.Confirmticket">

    <!-- ===== TOP HEADER - "Detail Pesanan" ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/backarrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/backarrow"
            android:padding="4dp"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail Pesanan"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/headerSubTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sinar Jaya  •  Executive"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/infoicon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/info"
            app:tint="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== MAIN SCROLLABLE CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- TRIP SUMMARY BANNER -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Schedule Info -->
                    <TextView
                        android:id="@+id/tripScheduleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="07:00 — 13:30  •  6j 30m"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:lineSpacingExtra="3dp" />

                    <!-- Route Info -->
                    <TextView
                        android:id="@+id/tripRouteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pulo Gebang → Bandung"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Price Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Harga Tiket"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/bannerPriceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Rp 180.000"
                            android:textSize="16sp"
                            android:textColor="@color/colorPrimary"
                            android:fontFamily="@font/poppins_bold" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- INFORMASI PENUMPANG & PEMESAN CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rincian Pemesan &amp; Tiket"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Item 1: Nama Pemesan -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/passengerNameText"
                            android:layout_marginEnd="8dp"
                            android:text="Nama Pemesan"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/passengerNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Laras Chika"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </RelativeLayout>

                    <!-- Item 2: No Telp -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/passengerPhoneText"
                            android:layout_marginEnd="8dp"
                            android:text="No. HP"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/passengerPhoneText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0812-3456-7890"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </RelativeLayout>

                    <!-- Item 3: Operator Bus -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/armadaBusText"
                            android:layout_marginEnd="8dp"
                            android:text="Armada Bus"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/armadaBusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Sinar Jaya Shuttle"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </RelativeLayout>

                    <!-- Item 4: Nomor Kursi / Detail Kursi -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/labelNomorKursi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/seatNumberDetailText"
                            android:layout_marginEnd="8dp"
                            android:text="Rincian Kursi"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/seatNumberDetailText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="01 (Otomatis Ditentukan)"
                            android:textSize="12sp"
                            android:textColor="@color/colorPrimary"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="end"
                            android:textAlignment="viewEnd" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hidden optional fields for compatibility -->
            <ImageView
                android:id="@+id/L11"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== PERSISTENT BOTTOM SUMMARY BAR ===== -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/selectedSeatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Pembayaran (1 Kursi)"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/priceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 180.000"
                        android:textSize="20sp"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmticket"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Lanjutkan Pembayaran"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_bold"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
