<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context="orbit.ac.id.dashboard_booking">

    <!-- ===== HEADER BAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="38dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="3dp">

        <!-- Back Arrow Button for smooth navigation back to Home -->
        <FrameLayout
            android:id="@+id/btnBackContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/backarrow"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Header Title & Subtitle Area (Clickable to change route/date) -->
        <LinearLayout
            android:id="@+id/headerSubtitleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:padding="2dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasil Pencarian"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/headerSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pulo Gebang, Jakarta → Bandung  •  Sab, 25 Okt"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Calendar Icon -->
        <FrameLayout
            android:id="@+id/btnCalendarContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/headerCalendarIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/calendar"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

    </LinearLayout>

    <!-- ===== CATEGORY FILTER CHIPS ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioGroup
                android:id="@+id/radioGroupBusClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioAllClass"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Semua"
                    android:checked="true"
                    android:button="@null"
                    android:background="@drawable/round_corner_bgblue"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/radioExecutive"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Executive"
                    android:button="@null"
                    android:background="@drawable/filter_chip_bg"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/radioSleeper"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Sleeper"
                    android:button="@null"
                    android:background="@drawable/filter_chip_bg"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/radioEconomy"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Economy"
                    android:button="@null"
                    android:background="@drawable/filter_chip_bg"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center" />
            </RadioGroup>

            <TextView
                android:id="@+id/filterFasilitasBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Fasilitas ▾"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/filter_chip_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== BUS LIST SCROLLVIEW ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <ProgressBar
                android:id="@+id/progressbarseatbooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- BUS CARD 1 (SINAR JAYA - EXECUTIVE) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/relativeticketview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rekomendasi"
                            android:textSize="10sp"
                            android:textColor="#059669"
                            android:fontFamily="@font/poppins_semibold"
                            android:background="@drawable/badge_green_bg"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tersedia 12 kursi"
                            android:textSize="11sp"
                            android:textColor="#059669"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <!-- Bus Operator & Image Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:id="@+id/busroutetextonticketedit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sinar Jaya"
                                android:textSize="17sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Executive Class"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/busfront"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>

                    <!-- Timing & Duration Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/departureTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="07:00"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" — "
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/arrivalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13:30"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  •  6j 30m"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Price & Action Button Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <TextView
                                android:id="@+id/busPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 180.000"
                                android:textSize="18sp"
                                android:textColor="@color/colorPrimary"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:id="@+id/seatonticketedit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per kursi"
                                android:textSize="10sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnDetailSinarJaya"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Detail"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:background="@drawable/filter_chip_bg"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUS CARD 2 (MURNI JAYA - EXECUTIVE) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMurniJaya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Murni Jaya"
                                android:textSize="17sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Economy AC 2+2"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/busfinal"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:30 — 15:00  •  6j 30m"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Rp 135.000"
                            android:textSize="18sp"
                            android:textColor="@color/colorPrimary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/btnDetailMurniJaya"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Detail"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:background="@drawable/filter_chip_bg"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUS CARD 3 (AGRA MAS - SLEEPER) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAgraMas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agra Mas"
                                android:textSize="17sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sleeper Luxury"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/busfront"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15:30 — 22:00  •  6j 30m"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Rp 240.000"
                            android:textSize="18sp"
                            android:textColor="@color/colorPrimary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/btnDetailAgraMas"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Detail"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:background="@drawable/filter_chip_bg"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUS CARD 4 (RESTU - ECONOMY) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRestu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Restu Express"
                                android:textSize="17sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Economy AC"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/busfinal"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19:00 — 01:30  •  6j 30m"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Rp 110.000"
                            android:textSize="18sp"
                            android:textColor="@color/colorPrimary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/btnDetailRestu"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Detail"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:background="@drawable/filter_chip_bg"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUS CARD 5 (ROSALIA INDAH - EXECUTIVE) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRosalia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rosalia Indah"
                                android:textSize="17sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Executive Plus 2+2"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/busfront"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21:30 — 04:00  •  6j 30m"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_semibold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Rp 195.000"
                            android:textSize="18sp"
                            android:textColor="@color/colorPrimary"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/btnDetailRosalia"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Detail"
                            android:textColor="@color/colorPrimary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:background="@drawable/filter_chip_bg"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EMPTY STATE LAYOUT -->
            <LinearLayout
                android:id="@+id/emptyStateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_baseline_directions_bus_24"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak Ada Bus Ditemukan"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak ada jadwal bus yang sesuai dengan filter jam / kelas yang dipilih."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnResetFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Tampilkan Semua Bus"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/colorPrimary" />
            </LinearLayout>

            <!-- Hidden compatibility fields -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/serchbustn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trackbusbtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/setdatedate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/day_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/editTextonseatbooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/recentbookedtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/dateonticket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/departureStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/arrivalStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/outboxofbusrouteonbooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
