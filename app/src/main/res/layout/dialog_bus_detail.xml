<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/offwhitecard"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- DRAG HANDLE -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@color/divider"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- HEADER BAR: BUS OPERATOR & BUS IMAGE -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/detailBusImage">

            <TextView
                android:id="@+id/detailOperatorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Murni Jaya"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/detailBusClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Executive Class 2+2"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/detailBusImage"
            android:layout_width="70dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/busfront"
            android:scaleType="fitCenter" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="14dp" />

    <!-- TRIP DETAILS SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Item 1: Rute -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_location_on_24"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rute Perjalanan"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/detailRouteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pulo Gebang, Jakarta → Bandung"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_semibold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Item 2: Tanggal & Jadwal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/calendar"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanggal &amp; Jadwal"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/detailScheduleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sab, 25 Okt 2025  •  08:30 - 15:00 WIB"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_semibold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Item 3: Info Jumlah Tiket yang Sudah Dipilih (Tanpa Disuruh Input Ulang) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/filter_chip_bg"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/passengerBadgeContainer">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_baseline_account_circle_24"
                    app:tint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Tiket Dipesan"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/detailPassengerSummaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01 Dewasa"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Badge konfirmasi tiket sudah terpilih -->
            <LinearLayout
                android:id="@+id/passengerBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_green_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Sudah Dipilih"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold" />
            </LinearLayout>

            <!-- Hidden Views for backward compatibility with Java bindings if needed -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView android:id="@+id/tvDetailAdultCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnDetailMinusAdult" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnDetailPlusAdult" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvDetailInfantCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnDetailMinusInfant" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnDetailPlusInfant" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp" />

    <!-- PRICE & ACTION ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailPriceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total (01 Dewasa)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins" />

            <TextView
                android:id="@+id/detailPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 170.000"
                android:textSize="18sp"
                android:textColor="@color/colorPrimary"
                android:fontFamily="@font/poppins_bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookBusDetail"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Pesan Tiket"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>
